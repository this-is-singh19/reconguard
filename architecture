Schema Definitions-- Partitioned transactions table
CREATE TABLE transactions (
    id                      UUID          NOT NULL DEFAULT gen_random_uuid(),
    tenant_id               UUID          NOT NULL REFERENCES tenants(id),
    order_id                TEXT          NOT NULL,
    gateway_transaction_id  TEXT,
    amount                  NUMERIC(18,6) NOT NULL,
    currency                CHAR(3)       NOT NULL,
    status                  TEXT          NOT NULL DEFAULT 'PENDING',
    order_ts                TIMESTAMPTZ,
    payment_ts              TIMESTAMPTZ,
    reconciled_at           TIMESTAMPTZ,
    created_at              TIMESTAMPTZ   NOT NULL DEFAULT NOW()
) PARTITION BY LIST (tenant_id);-- One partition per tenant (created at onboarding time)
CREATE TABLE transactions_tenant_acme
    PARTITION OF transactions FOR VALUES IN ('uuid-of-acme');-- Reconciliation failures with pgvector
CREATE EXTENSION IF NOT EXISTS vector;
CREATE TABLE reconciliation_failures (
    id                  UUID          NOT NULL DEFAULT gen_random_uuid(),
    tenant_id           UUID          NOT NULL REFERENCES tenants(id),
    transaction_id      UUID          REFERENCES transactions(id),
    failure_reason      TEXT          NOT NULL,
    failure_code        TEXT,
    raw_context         JSONB,
    context_embedding   vector(1536),
    created_at          TIMESTAMPTZ   NOT NULL DEFAULT NOW(),
    PRIMARY KEY (id)
) PARTITION BY LIST (tenant_id);
CREATE TABLE known_issues (
    id                    UUID          NOT NULL DEFAULT gen_random_uuid() PRIMARY KEY,
    title                 TEXT          NOT NULL,
    description           TEXT          NOT NULL,
    resolution_template   TEXT          NOT NULL,
    embedding             vector(1536),
    confidence_threshold  FLOAT         NOT NULL DEFAULT 0.85,
    created_at            TIMESTAMPTZ   NOT NULL DEFAULT NOW()
);
CREATE TABLE resolution_suggestions (
    id                    UUID          NOT NULL DEFAULT gen_random_uuid() PRIMARY KEY,
    failure_id            UUID          NOT NULL REFERENCES reconciliation_failures(id),
    known_issue_id        UUID          REFERENCES known_issues(id),
    similarity_score      FLOAT,
    classification_status TEXT          NOT NULL,
    resolution_text       TEXT,
    auto_applied          BOOLEAN       NOT NULL DEFAULT false,
    created_at            TIMESTAMPTZ   NOT NULL DEFAULT NOW()
);
Indexing Strategy-- Standard queries: tenant + time range lookups
CREATE INDEX idx_transactions_tenant_created ON transactions (tenant_id, created_at DESC);
CREATE INDEX idx_transactions_order_id ON transactions (tenant_id, order_id);
CREATE INDEX idx_transactions_gateway_id ON transactions (tenant_id, gateway_transaction_id);
CREATE INDEX idx_transactions_status ON transactions (tenant_id, status) WHERE status != 'MATCHED';-- HNSW index for vector similarity (pgvector >= 0.5)-- m=16 ef_construction=64 is recommended starting point for < 10M vectors
CREATE INDEX idx_known_issues_embedding_hnsw ON known_issues
    USING hnsw (embedding vector_cosine_ops)
    WITH (m = 16, ef_construction = 64);
CREATE INDEX idx_recon_failures_embedding_hnsw ON reconciliation_failures
    USING hnsw (context_embedding vector_cosine_ops)
    WITH (m = 16, ef_construction = 64);
HNSW vs IVFFlat rationale: HNSW does not require a training step. At 1,000 events/sec/tenant with continuous
inserts, HNSW's incremental-build model is far more operationally predictable.
